#!/bin/sh
set -eu

uci -q set system.@system[0].hostname='WrtMax'

uci -q set network.lan.proto='static'
uci -q set network.lan.ipaddr='192.168.1.20'
uci -q set network.lan.netmask='255.255.255.0'

# Preserve existing radio device sections; only set requested AP defaults.
RADIOS="$(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p')"
INDEX=0
for radio in $RADIOS; do
    INDEX=$((INDEX + 1))
    uci -q set "wireless.$radio.country=US"
    uci -q set "wireless.$radio.disabled=0"
    if [ "$INDEX" -eq 1 ]; then
        uci -q set "wireless.$radio.channel=6"
        uci -q set "wireless.$radio.htmode=HE20"
        uci -q set "wireless.$radio.txpower=30"
    elif [ "$INDEX" -eq 2 ]; then
        uci -q set "wireless.$radio.channel=36"
        uci -q set "wireless.$radio.htmode=HE40"
        uci -q set "wireless.$radio.txpower=32"
    fi
done

# Map wifi-iface sections to radio order.
IFACES="$(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p')"
INDEX=0
for iface in $IFACES; do
    INDEX=$((INDEX + 1))
    uci -q set "wireless.$iface.mode=ap"
    uci -q set "wireless.$iface.network=lan"
    uci -q set "wireless.$iface.encryption=none"
    uci -q set "wireless.$iface.ieee80211r=1"
    uci -q set "wireless.$iface.ieee80211k=1"
    uci -q set "wireless.$iface.ieee80211v=1"
    if [ "$INDEX" -eq 1 ]; then
        uci -q set "wireless.$iface.ssid=AbduRaheem_2G"
        uci -q set "wireless.$iface.he_bss_color=8"
    elif [ "$INDEX" -eq 2 ]; then
        uci -q set "wireless.$iface.ssid=AbduRaheem_5G"
        uci -q set "wireless.$iface.he_bss_color=16"
    fi
done

uci -q set firewall.@defaults[0].flow_offloading='1'
uci -q set firewall.@defaults[0].flow_offloading_hw='1'

uci -q set mndpd.@mndpd[0].hostname='WrtMax' 2>/dev/null || true
uci -q set mndpd.@mndpd[0].ipaddr='192.168.1.20' 2>/dev/null || true

uci commit system
uci commit network
uci commit wireless
uci commit firewall
uci commit mndpd 2>/dev/null || true
exit 0
