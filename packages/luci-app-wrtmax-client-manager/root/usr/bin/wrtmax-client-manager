#!/bin/sh
set -eu
case "${1:-status}" in
status)
 echo "DHCP leases:"; cat /tmp/dhcp.leases 2>/dev/null || true
 echo "Wireless stations:"
 for i in $(iw dev 2>/dev/null | awk '$1=="Interface"{print $2}'); do
  echo "[$i]"; iw dev "$i" station dump 2>/dev/null | grep -E 'Station |signal:|tx bitrate:|rx bitrate:' || true
 done ;;
block)
 mac="${2:-}"
 case "$mac" in *[!0-9a-fA-F:]*|'') echo "Invalid MAC"; exit 2 ;; esac
 [ "${#mac}" -eq 17 ] || exit 2
 nft add table inet wrtmax_clients 2>/dev/null || true
 nft 'add chain inet wrtmax_clients input { type filter hook input priority -5; policy accept; }' 2>/dev/null || true
 nft add rule inet wrtmax_clients input ether saddr "$mac" drop
 echo "Input block added for $mac (router access only; configure forwarding chain for client isolation)." ;;
*) echo "Usage: wrtmax-client-manager {status|block MAC}"; exit 2 ;;
esac
