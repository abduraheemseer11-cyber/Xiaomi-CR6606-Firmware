#!/bin/sh
set -eu
case "${1:-status}" in
status)
 echo "WrtMax Firmware Solutions | Support: 776 538 297"
 echo "Uptime: $(cut -d. -f1 /proc/uptime) seconds"
 awk '/MemTotal|MemAvailable/ {print}' /proc/meminfo
 found=0
 for f in /sys/class/hwmon/hwmon*/temp1_input; do
  [ -r "$f" ] || continue
  awk -v t="$(cat "$f")" 'BEGIN {printf "Wi-Fi chip temperature: %.1f C\n",t/1000}'
  found=1
 done
 [ "$found" -eq 1 ] || echo "Wi-Fi chip temperature: unavailable"
 for p in wan lan1 lan2 lan3; do
  [ -e "/sys/class/net/$p/operstate" ] && echo "$p: $(cat "/sys/class/net/$p/operstate")"
 done
 for d in $(iw dev 2>/dev/null | awk '$1=="Interface"{print $2}'); do
  echo "Radio interface: $d"
  iw dev "$d" station dump 2>/dev/null | grep -c '^Station' | awk '{print "Stations: "$1}'
 done
 for n in wan br-lan; do
  [ -r "/sys/class/net/$n/statistics/rx_bytes" ] && echo "$n RX: $(cat "/sys/class/net/$n/statistics/rx_bytes") bytes"
  [ -r "/sys/class/net/$n/statistics/tx_bytes" ] && echo "$n TX: $(cat "/sys/class/net/$n/statistics/tx_bytes") bytes"
 done ;;
 *) echo "Usage: wrtmax-dashboard status"; exit 2 ;;
esac
