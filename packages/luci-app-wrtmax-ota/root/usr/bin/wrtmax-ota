#!/bin/sh
set -eu
CFG=wrtmax-ota.main; DIR=/tmp/wrtmax-ota; STATE=/tmp/wrtmax-ota-status
mkdir -p "$DIR"
log(){ printf '%s\n' "$*" | tee "$STATE"; }
url(){ uci -q get "$CFG.url" || echo https://ota.wrtmax.local/cr6606/latest.json; }
gt(){ awk -v a="$1" -v b="$2" 'BEGIN{na=split(a,A,".");nb=split(b,B,".");n=na>nb?na:nb;for(i=1;i<=n;i++){x=i<=na?A[i]+0:0;y=i<=nb?B[i]+0:0;if(x>y)exit 0;if(x<y)exit 1}exit 1}'; }
case "${1:-status}" in
configure) case "${2:-}" in https://*) uci set "$CFG.url=$2"; uci commit wrtmax-ota; log "URL saved" ;; *) log "HTTPS URL required"; exit 2 ;; esac ;;
check)
 curl -fLsS --connect-timeout 15 --max-time 60 "$(url)" -o "$DIR/latest.json"
 v="$(jsonfilter -i "$DIR/latest.json" -e '@.version')"; u="$(jsonfilter -i "$DIR/latest.json" -e '@.url')"; h="$(jsonfilter -i "$DIR/latest.json" -e '@.sha256')"
 case "$v" in ''|*[!0-9.]*) log "Invalid version"; exit 1 ;; esac
 case "$u" in https://*) ;; *) log "HTTPS image URL required"; exit 1 ;; esac
 case "$h" in *[!a-fA-F0-9]*|'') log "Invalid SHA256"; exit 1 ;; esac
 [ "${#h}" -eq 64 ] || { log "Invalid SHA256 length"; exit 1; }
 printf '%s\n' "$v" > "$DIR/version"; printf '%s\n' "$u" > "$DIR/url"; printf '%s\n' "$h" > "$DIR/sha"
 current="$(cat /etc/wrtmax_version 2>/dev/null || echo 1.0.0)"
 if gt "$v" "$current"; then log "UPDATE AVAILABLE: $current -> $v"; else log "No newer version; installed $current"; fi ;;
install)
 [ -s "$DIR/version" ] && [ -s "$DIR/url" ] && [ -s "$DIR/sha" ] || { log "Run check first"; exit 1; }
 curl -fLsS --connect-timeout 20 --max-time 1800 "$(cat "$DIR/url")" -o "$DIR/firmware.bin"
 actual="$(sha256sum "$DIR/firmware.bin" | awk '{print $1}')"
 [ "$actual" = "$(cat "$DIR/sha")" ] || { rm -f "$DIR/firmware.bin"; log "SHA256 mismatch"; exit 1; }
 sysupgrade -T "$DIR/firmware.bin"
 log "Image validated; executing sysupgrade -n"
 sysupgrade -n "$DIR/firmware.bin" ;;
status) cat "$STATE" 2>/dev/null || echo "No OTA operation yet." ;;
*) echo "Usage: wrtmax-ota {status|check|install|configure HTTPS_URL}"; exit 2 ;;
esac
