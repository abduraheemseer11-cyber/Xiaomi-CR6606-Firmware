#!/bin/sh
set -eu
case "${1:-status}" in
status) uci show wireless | grep -E 'country=|channel=|htmode=|txpower=|he_bss_color=' || true ;;
apply)
 country="${2:-US}"; power="${3:-20}"; mode="${4:-HE20}"
 case "$country" in 00|US|CN|DE) ;; *) exit 2 ;; esac
 case "$power" in ''|*[!0-9]*) exit 2 ;; esac
 [ "$power" -ge 1 ] && [ "$power" -le 32 ] || exit 2
 case "$mode" in HE20|HE40|HE80|HT20|HT40|VHT20|VHT40|VHT80) ;; *) exit 2 ;; esac
 for s in $(uci show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
  uci set "wireless.$s.country=$country"; uci set "wireless.$s.txpower=$power"; uci set "wireless.$s.htmode=$mode"
 done
 uci commit wireless; wifi reload
 echo "Requested settings saved; regulatory and EEPROM limits remain authoritative." ;;
*) echo "Usage: wrtmax-driver {status|apply COUNTRY POWER HTMODE}"; exit 2 ;;
esac
