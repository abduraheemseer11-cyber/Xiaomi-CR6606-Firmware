#!/bin/sh
set -eu
case "${1:-scan}" in
scan)
 for i in $(iw dev 2>/dev/null | awk '$1=="Interface"{print $2}'); do
  echo "=== $i ==="
  iw dev "$i" scan 2>/dev/null | awk '/^BSS /{b=$2} /freq:/{f=$2} /signal:/{s=$2} /SSID:/{print b, f, s, $0}'
 done ;;
select) echo "Scan complete. Select the least occupied legal channel after reviewing nearby BSSs." ;;
status) echo "Use Scan to inspect nearby networks." ;;
*) echo "Usage: wrtmax-wifi-analyzer {scan|select|status}"; exit 2 ;;
esac
