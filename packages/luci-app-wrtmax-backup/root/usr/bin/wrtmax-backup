#!/bin/sh
set -eu
ARCH=/tmp/wrtmax-backup.tar.gz; WORK=/tmp/wrtmax-backup
case "${1:-status}" in
create)
 rm -rf "$WORK"; mkdir -p "$WORK/etc"
 cp -R /etc/config "$WORK/etc/"
 mkdir -p "$WORK/etc/wrtmax"; [ ! -f /etc/wrtmax_version ] || cp /etc/wrtmax_version "$WORK/etc/wrtmax/version"
 printf 'format=1\nmodel=xiaomi_mi-router-cr6606\ncreated=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" > "$WORK/manifest"
 tar -czf "$ARCH" -C "$WORK" etc manifest; chmod 600 "$ARCH"; sha256sum "$ARCH"; echo "Created $ARCH" ;;
restore)
 src="${2:-$ARCH}"; preserve="${3:-yes}"
 [ "$preserve" = yes ] || [ "$preserve" = no ] || exit 2
 [ -f "$src" ] || { echo "Archive missing"; exit 1; }
 tar -tzf "$src" >/dev/null
 check=/tmp/wrtmax-restore-check; rm -rf "$check"; mkdir -p "$check"; tar -xzf "$src" -C "$check"
 [ -d "$check/etc/config" ] && [ -f "$check/manifest" ] || { echo "Invalid WrtMax archive"; exit 1; }
 find "$check" -type l | grep -q . && { echo "Symlinks rejected"; exit 1; }
 for f in "$check"/etc/config/*; do [ -f "$f" ] || continue; case "$(basename "$f")" in *[!A-Za-z0-9_-]*) exit 1 ;; esac; done
 oldhost="$(uci -q get system.@system[0].hostname || echo WrtMax)"
 for f in "$check"/etc/config/*; do
  [ -f "$f" ] || continue
  case "$(basename "$f")" in network|wireless|firewall|system|dhcp|wrtmax*) cp "$f" "/etc/config/$(basename "$f")" ;; esac
 done
 if [ "$preserve" = yes ]; then uci set system.@system[0].hostname="$oldhost"; uci commit system; fi
 uci commit; /sbin/reload_config; echo "Selected configuration restored; review network settings before reboot." ;;
status) [ -f "$ARCH" ] && ls -l "$ARCH" || echo "No backup archive found." ;;
*) echo "Usage: wrtmax-backup {create|restore [FILE] [yes|no]|status}"; exit 2 ;;
esac
