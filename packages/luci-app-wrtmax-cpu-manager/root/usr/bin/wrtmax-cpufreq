#!/bin/sh
set -eu
apply() {
 g="$1"
 case "$g" in performance|ondemand|powersave|schedutil) ;; *) echo "Invalid governor"; exit 2 ;; esac
 found=0
 for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
  [ -w "$f" ] || continue; echo "$g" > "$f"; found=1
 done
 [ "$found" -eq 1 ] || echo "cpufreq unavailable on this kernel/platform"
}
case "${1:-status}" in
set) apply "${2:-ondemand}" ;;
daemon) while :; do load="$(awk '{print int($1)}' /proc/loadavg)"; if [ "$load" -ge 2 ]; then apply performance || true; else apply ondemand || true; fi; sleep 15; done ;;
status) for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do [ -r "$f" ] && echo "$f: $(cat "$f")"; done ;;
*) echo "Usage: wrtmax-cpufreq {status|set GOVERNOR|daemon}"; exit 2 ;;
esac
